# Copy to .dev.vars (gitignored). Use a long random value. Never commit the real token.
RELAY_ADMIN_TOKEN=replace-with-a-long-random-string

# Optional car chat webhook (see README "Car chat"). Leave unset to only queue
# messages for `abridge car listen`. Never commit real values.
# CAR_WEBHOOK_URL=https://your-webhook.example/path
# CAR_WEBHOOK_KEY=replace-with-the-webhook-secret
# CAR_WEBHOOK_AUTH_HEADER=Authorization
# CAR_WEBHOOK_AUTH_SCHEME=Bearer
